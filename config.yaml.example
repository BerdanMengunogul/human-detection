# Copy this file to config.yaml to override any of the defaults below.
# Every key is optional - omit anything you want left at its default.
# Env vars (HD_<NAME>, e.g. HD_EXIT_GRACE_SECONDS=2.0) take precedence over
# this file. RTSP camera credentials are NOT configured here - see .env.

# --- Model paths ---
# MODEL_NAME: yolov8s.pt
# REID_MODEL_NAME: yolo26m-reid.onnx
# TRACKER_CONFIG: tracker_reid.yaml
# POSE_MODEL_NAME: yolov8s-pose.pt

# --- Performance ---
# Inference input size for both the detect and pose models. The camera is
# 2560x1440 and YOLO otherwise letterboxes to a much larger input; 640 costs
# almost no recall at room scale and roughly halves detection time.
# 0 leaves the size to Ultralytics (markedly slower).
# INFER_IMGSZ: 640
# FP16 inference. Real speedup on an RTX-class GPU; ignored on CPU, where fp16
# is emulated and slower.
# INFER_HALF: true
# Cap on the main loop's rate. Rarely binds in practice - the frame reader
# already blocks for a genuinely new frame - but stops a faster source from
# spinning the loop on frames the camera hasn't replaced yet. 0 disables.
# TARGET_FPS: 30.0
# MJPEG stream quality (OpenCV's default is 95, near-lossless). 75 looks
# near-identical for a monitoring feed at a fraction of the bytes.
# JPEG_QUALITY: 75

# --- Detection ---
# PERSON_CLASS_ID: 0
# CONF_THRESHOLD: 0.5
# DISPLAY_MAX_WIDTH: 1280
# DISPLAY_MAX_HEIGHT: 720

# --- Pose ---
# POSE_CONF_THRESHOLD: 0.5
# POSE_KEYPOINT_CONF_THRESHOLD: 0.5
# POSE_IOU_MATCH_THRESHOLD: 0.3

# --- Box filtering / smoothing ---
# MIN_BOX_AREA_FRACTION: 0.001
# COUNT_SMOOTHING_WINDOW: 7
# BOX_SMOOTHING_ALPHA: 0.4
# BOX_COAST_FRAMES: 5

# --- Re-ID ---
# REID_MATCH_THRESHOLD: 0.35
# REID_BORDERLINE_THRESHOLD: 0.30
# REID_CORROBORATION_THRESHOLD: 0.25
# REID_CORROBORATION_MIN_SAMPLES: 2
# REID_HIGH_CONF_THRESHOLD: 0.6
# REID_TOPK_MATCH: 3
# REID_TOPUP_INTERVAL_SECONDS: 2.0
# REID_MAX_SAMPLES_PER_PERSON: 5

# --- Face ---
# FACE_MATCH_THRESHOLD: 0.5
# FACE_HIGH_CONF_THRESHOLD: 0.55
# FACE_MAX_SAMPLES_PER_PERSON: 5
# FACE_MIN_BOX_HEIGHT: 40

# --- Identify / exit timing ---
# IDENTIFY_DELAY_SECONDS: 0.35
# IDENTIFY_MIN_CANDIDATES: 3
# EXIT_GRACE_SECONDS: 1.0

# --- Misc ---
# PROFILE_REPORT_INTERVAL: 60

# --- Paths (relative values resolve against this file's directory) ---
# ZONES_PATH: door_zones.json
# ZONES_VERSION_PATH: door_zones.version
# PEOPLE_PATH: people.json
# GALLERY_PATH: gallery.npz

# --- Database (PostgreSQL) ---
# DB_PASSWORD is NOT configured here - see .env.
# DB_HOST: localhost
# DB_PORT: 5433
# DB_NAME: human_detection
# DB_USER: postgres

# --- ntfy.sh push notifications for zone alerts ---
# Set NTFY_TOPIC to enable; leave empty/unset to disable. Pick a hard-to-
# guess topic name - anyone who knows it can read your alerts on public
# ntfy.sh, or self-host and point NTFY_SERVER at your own instance.
# NTFY_SERVER: https://ntfy.sh
# NTFY_TOPIC: ""

# --- ReID training-data collection ---
# Off by default. When enabled, saves identified/topped-up person crops to
# <DATASET_PATH>/<person_id>/ for later use in fine-tuning a ReID model.
# DATASET_COLLECTION_ENABLED: false
# DATASET_PATH: dataset
# DATASET_MAX_SAMPLES_PER_PERSON: 200
# DATASET_MIN_SAVE_INTERVAL_SECONDS: 1.0
